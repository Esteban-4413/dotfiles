# vim-style motions

screen_down <C-d>
screen_up <C-u>
prev_state <C-o>
toggle_titlebar <C-w>
next_state <C-i>
zoom_in J
zoom_out K

close_window q

toggle_dark_mode i
toggle_custom_color c
reload_config r
fit_to_page_width s
toggle_statusbar S
toggle_two_page_mode D
helper_window

# Latex
synctex_under_cursor H
toggle_synctex L
